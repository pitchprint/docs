{
  "name": "helpscout-docs-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Help Scout Docs API client using Basic Auth",
  "scripts": {
    "example": "node --env-file=.env scripts/example.js",
    "convert": "node scripts/convert-to-markdown.js",
    "drift": "node scripts/report-drift.js",
    "baseline": "node scripts/report-drift.js --write",
    "ingest": "node --env-file-if-exists=.env scripts/ingest-new.js",
    "registry": "node scripts/registry.js",
    "links": "node scripts/check-links.mjs",
    "publish": "node scripts/publish-to-docs.js",
    "blog-fetch": "node scripts/fetch-blog-releases.js",
    "blog-sync": "node scripts/ingest-blog-releases.mjs",
    "blog-benchmark": "node scripts/ingest-blog-releases.mjs --benchmark",
    "blog-summaries": "node scripts/generate-blog-summaries.js",
    "release-notes": "node scripts/ingest-release-notes.mjs",
    "test": "node scripts/test-tidy.mjs && node scripts/test-validate.mjs && node scripts/test-style-pass.mjs && node scripts/test-release-notes.mjs && node scripts/test-blog-releases.mjs && node scripts/test-validate-release-note.mjs"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
