# Help Scout Docs API credentials for the sync pipeline.
#
#   cp .env.example .env      then fill in HELPSCOUT_API_KEY
#
# .env is gitignored — never commit real credentials. In CI the values come
# from the HELPSCOUT_API_KEY repository secret; see scripts/README.md.
#
# Basic Auth convention: the API key is the USERNAME and the password is
# ignored for reads, so "X" is the conventional placeholder.
#
# Get a key from Help Scout: Manage -> Docs -> API Keys.
# Quote the value if it contains a "#", or dotenv treats the rest as a comment.

HELPSCOUT_BASE_URL="https://docsapi.helpscout.net/v1"
HELPSCOUT_API_KEY="your_api_key_here"
HELPSCOUT_API_PASSWORD="X"
